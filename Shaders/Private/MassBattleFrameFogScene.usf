#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

// One compact source per logical provider: world XY + velocity XY.
Buffer<float> VisionSourcePositions;
float VisionRadiusUU;
float VisionPredictionSeconds;
float SceneProjectionPlaneZ;
float2 WorldMaskMin;
float2 WorldMaskSize;
float VisibilityStateValue;
float2 OutputExtent;
float2 ViewRectMin;
float2 ViewRectSize;
float FogOpacity;
uint Debug;
uint DebugRevealAll;
Texture2D SceneColor;
Texture2D VisibilityMask;
SamplerState LinearSampler;

static const float2 QuadCorners[6] =
{
	float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0),
	float2(0.0, 1.0), float2(1.0, 0.0), float2(1.0, 1.0)
};

float4 LoadVisionSource(uint AgentIndex)
{
	const uint FloatOffset = AgentIndex * 4u;
	return float4(
		VisionSourcePositions[FloatOffset + 0u],
		VisionSourcePositions[FloatOffset + 1u],
		VisionSourcePositions[FloatOffset + 2u],
		VisionSourcePositions[FloatOffset + 3u]);
}

struct FVisionVSToPS
{
	float4 Position : SV_Position;
	float2 CircleUV : TEXCOORD0;
};

FVisionVSToPS VisionVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID)
{
	FVisionVSToPS Output;
	ResolvedView = ResolveView();

	const float4 Source = LoadVisionSource(InstanceID);
	const float2 Center = Source.xy + Source.zw * VisionPredictionSeconds;
	const float2 Offset = (QuadCorners[VertexID] - 0.5) * (2.0 * VisionRadiusUU);
	const float3 WorldPosition = float3(Center + Offset, SceneProjectionPlaneZ);

	Output.Position = mul(
		float4(DFFastToTranslatedWorld(WorldPosition, ResolvedView.PreViewTranslation), 1.0),
		ResolvedView.TranslatedWorldToClip);
	Output.CircleUV = QuadCorners[VertexID] * 2.0 - 1.0;
	return Output;
}

float4 VisionPS(FVisionVSToPS Input) : SV_Target0
{
	clip(1.0 - dot(Input.CircleUV, Input.CircleUV));
	return VisibilityStateValue.xxxx;
}

FVisionVSToPS WorldMaskVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID)
{
	FVisionVSToPS Output;
	const float4 Source = LoadVisionSource(InstanceID);
	const float2 Center = Source.xy + Source.zw * VisionPredictionSeconds;
	const float2 Offset = (QuadCorners[VertexID] - 0.5) * (2.0 * VisionRadiusUU);
	const float2 WorldPosition = Center + Offset;
	const float2 MaskUV = (WorldPosition - WorldMaskMin) / max(WorldMaskSize, 1.0.xx);
	Output.Position = float4(MaskUV.x * 2.0 - 1.0, 1.0 - MaskUV.y * 2.0, 0.0, 1.0);
	Output.CircleUV = QuadCorners[VertexID] * 2.0 - 1.0;
	return Output;
}

float4 WorldMaskPS(FVisionVSToPS Input) : SV_Target0
{
	clip(1.0 - dot(Input.CircleUV, Input.CircleUV));
	return VisibilityStateValue.xxxx;
}

struct FCompositeVSToPS
{
	float4 Position : SV_Position;
	float2 SceneUV : TEXCOORD0;
	float2 MaskUV : TEXCOORD1;
};

FCompositeVSToPS CompositeVS(uint VertexID : SV_VertexID)
{
	FCompositeVSToPS Output;
	const float2 Pixel = ViewRectMin + QuadCorners[VertexID] * ViewRectSize;
	Output.Position = float4(
		Pixel / OutputExtent * float2(2.0, -2.0) + float2(-1.0, 1.0),
		0.0,
		1.0);
	Output.SceneUV = Pixel / OutputExtent;
	Output.MaskUV = Output.SceneUV;
	return Output;
}

float4 CompositePS(FCompositeVSToPS Input) : SV_Target0
{
	const float4 Scene = SceneColor.Sample(LinearSampler, Input.SceneUV);
	if (DebugRevealAll != 0u)
	{
		return Scene;
	}

	const float Visibility = VisibilityMask.Sample(LinearSampler, Input.MaskUV).r;
	if (Debug != 0u)
	{
		return float4(Visibility.xxx, 1.0);
	}

	const float3 Fogged = Scene.rgb * (1.0 - FogOpacity);
	return float4(lerp(Fogged, Scene.rgb, saturate(Visibility)), Scene.a);
}
