#include "/Engine/Public/Platform.ush"

// Mass Battle Frame minimap. All per-agent projection, sizing and filtering stays on GPU.

Buffer<float4> UnitData;
Buffer<float4> VisionSources;
Buffer<float4> TeamColors;

float2 RectMin;
float2 RectSize;
float2 OutputExtent;
float2 MapMin;
float2 MapSize;
uint LogicalResolution;
float UnitRadiusUU;
float UnitBrightness;
float4 CombatUnitColor;
float NormalUnitColorLength;
float SelectedUnitColorLength;
uint bNormalizeTeamColorDirection;
float VisionRadiusUU;
uint TeamColorCount;
float FogOpacity;

struct FUnitVSToPS
{
	float4 Position : SV_Position;
	float4 Color : COLOR0;
};

struct FVisionVSToPS
{
	float4 Position : SV_Position;
	float2 CircleUV : TEXCOORD0;
};

static const float2 QuadCorners[6] =
{
	float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0),
	float2(0.0, 1.0), float2(1.0, 0.0), float2(1.0, 1.0)
};

float4 PixelToClip(float2 PixelPosition)
{
	const float2 NDC = float2(
		PixelPosition.x / OutputExtent.x * 2.0 - 1.0,
		1.0 - PixelPosition.y / OutputExtent.y * 2.0);
	return float4(NDC, 0.0, 1.0);
}

float2 WorldToWidgetPixel(float2 WorldXY)
{
	const float2 UV = (WorldXY - MapMin) / MapSize;
	// World XY is rotated 90 degrees counter-clockwise into minimap screen space.
	const float2 RotatedUV = float2(UV.y, 1.0 - UV.x);
	return RectMin + RotatedUV * RectSize;
}

float2 RoundedParticleDiameterPixels(float RadiusUU)
{
	const float Resolution = max(float(LogicalResolution), 1.0);
	const float2 WorldToLogicalScale = Resolution / MapSize;
	const float2 WorldDrawSize = float2(2.0 * RadiusUU, 2.0 * RadiusUU);
	const float2 LogicalDrawSize = max(
		ceil(WorldDrawSize * WorldToLogicalScale),
		float2(1.0, 1.0));

	const float2 WidgetPixelsPerLogicalPixel = RectSize / Resolution;
	const float2 RotatedDrawSizePixels = float2(
		LogicalDrawSize.y * WidgetPixelsPerLogicalPixel.x,
		LogicalDrawSize.x * WidgetPixelsPerLogicalPixel.y);
	const float SquareDiameter = max(
		max(RotatedDrawSizePixels.x, RotatedDrawSizePixels.y),
		max(WidgetPixelsPerLogicalPixel.x, WidgetPixelsPerLogicalPixel.y));
	return float2(SquareDiameter, SquareDiameter);
}

FUnitVSToPS UnitVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID)
{
	FUnitVSToPS Output;
	const float4 Unit = UnitData[InstanceID];
	const uint PackedState = asuint(Unit.w);
	const uint TeamID = PackedState & 1023u;
	const bool bAttacked = (PackedState & (1u << 10)) != 0u;
	const bool bSelected = (PackedState & (1u << 11)) != 0u;
	const bool bFullBrightness = (PackedState & (1u << 12)) != 0u;
	const bool bValid = TeamID < TeamColorCount;
	const float2 CenterPixel = WorldToWidgetPixel(Unit.xy);
	const float2 DiameterPixels = RoundedParticleDiameterPixels(UnitRadiusUU);
	const float2 PixelPosition = CenterPixel + (QuadCorners[VertexID] - 0.5) * DiameterPixels;
	Output.Position = bValid ? PixelToClip(PixelPosition) : float4(-2.0, -2.0, 0.0, 1.0);
	float4 TeamColor = bValid ? TeamColors[TeamID] : 0.0.xxxx;
	if (bSelected)
	{
		// Keep the original team hue and marker size, but make selection obvious.
		// The legacy strength parameters remain bound for hot-reload ABI stability,
		// but they never normalize or darken an unselected marker.
		const float SelectionBlend = bNormalizeTeamColorDirection != 0u
			? saturate(SelectedUnitColorLength - NormalUnitColorLength)
			: 0.40;
		TeamColor.rgb = lerp(TeamColor.rgb, 1.0.xxx, SelectionBlend);
	}
	TeamColor.rgb *= bFullBrightness ? 1.0 : UnitBrightness;
	// Combat is deliberately applied after fog brightness so a hit sample is
	// unambiguously white even for an AlwaysFogVisible city marker.
	Output.Color = bAttacked ? CombatUnitColor : TeamColor;
	return Output;
}

float4 UnitPS(FUnitVSToPS Input) : SV_Target0
{
	return Input.Color;
}

FVisionVSToPS VisionVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID)
{
	FVisionVSToPS Output;
	const float2 CenterPixel = WorldToWidgetPixel(VisionSources[InstanceID].xy);
	const float2 DiameterPixels = RoundedParticleDiameterPixels(VisionRadiusUU);
	const float2 PixelPosition = CenterPixel + (QuadCorners[VertexID] - 0.5) * DiameterPixels;
	Output.Position = PixelToClip(PixelPosition);
	Output.CircleUV = QuadCorners[VertexID] * 2.0 - 1.0;
	return Output;
}

float4 VisionPS(FVisionVSToPS Input) : SV_Target0
{
	clip(1.0 - dot(Input.CircleUV, Input.CircleUV));
	return 0.0.xxxx;
}

float4 FogVS(uint VertexID : SV_VertexID) : SV_Position
{
	return PixelToClip(RectMin + QuadCorners[VertexID] * RectSize);
}

float4 FogPS() : SV_Target0
{
	return float4(0.0, 0.0, 0.0, FogOpacity);
}
