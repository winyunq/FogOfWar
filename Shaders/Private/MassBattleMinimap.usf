#include "/Engine/Public/Platform.ush"

// Mass Battle Frame minimap. All per-agent projection, sizing and filtering stays on GPU.

Buffer<uint> LocationWords;
Buffer<float4> DynamicParams0;
Buffer<uint> IsHidden;
Buffer<float4> TeamColors;

float2 RectMin;
float2 RectSize;
float2 OutputExtent;
float2 MapMin;
float2 MapSize;
uint LogicalResolution;
float UnitRadiusUU;
float VisionRadiusUU;
uint ViewingTeamIndex;
uint TeamColorCount;
float FogOpacity;

struct FUnitVSToPS
{
	float4 Position : SV_Position;
	float4 Color : COLOR0;
};

struct FVisionVSToPS
{
	float4 Position : SV_Position;
	float2 CircleUV : TEXCOORD0;
};

static const float2 QuadCorners[6] =
{
	float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0),
	float2(0.0, 1.0), float2(1.0, 0.0), float2(1.0, 1.0)
};

float DoubleWordsToFloat(uint LowWord, uint HighWord)
{
	const uint Exponent = (HighWord >> 20u) & 0x7ffu;
	if (Exponent == 0u)
	{
		return 0.0;
	}

	const float Sign = (HighWord & 0x80000000u) != 0u ? -1.0 : 1.0;
	const float Mantissa = 1.0
		+ float(HighWord & 0x000fffffu) * (1.0 / 1048576.0)
		+ float(LowWord) * (1.0 / 4503599627370496.0);
	return Sign * exp2(float(int(Exponent) - 1023)) * Mantissa;
}

float2 LoadWorldXY(uint AgentIndex)
{
	const uint WordOffset = AgentIndex * 6u;
	return float2(
		DoubleWordsToFloat(LocationWords[WordOffset + 0u], LocationWords[WordOffset + 1u]),
		DoubleWordsToFloat(LocationWords[WordOffset + 2u], LocationWords[WordOffset + 3u]));
}

float4 PixelToClip(float2 PixelPosition)
{
	const float2 NDC = float2(
		PixelPosition.x / OutputExtent.x * 2.0 - 1.0,
		1.0 - PixelPosition.y / OutputExtent.y * 2.0);
	return float4(NDC, 0.0, 1.0);
}

float2 WorldToWidgetPixel(float2 WorldXY)
{
	const float2 UV = (WorldXY - MapMin) / MapSize;
	// World XY is rotated 90 degrees counter-clockwise into minimap screen space.
	const float2 RotatedUV = float2(UV.y, 1.0 - UV.x);
	return RectMin + RotatedUV * RectSize;
}

float2 RoundedDiameterPixels(float RadiusUU)
{
	const float2 CellSize = MapSize / max(float(LogicalResolution), 1.0);
	const float2 DiameterInCells = max(ceil((2.0 * RadiusUU) / CellSize), float2(1.0, 1.0));
	// After the 90-degree rotation, world Y spans screen X and world X spans screen Y.
	return float2(DiameterInCells.y * RectSize.x, DiameterInCells.x * RectSize.y)
		/ max(float(LogicalResolution), 1.0);
}

FUnitVSToPS UnitVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID)
{
	FUnitVSToPS Output;
	const uint TeamID = asuint(DynamicParams0[InstanceID].w) & 1023u;
	const bool bValid = IsHidden[InstanceID] == 0u && TeamID < TeamColorCount;
	const float2 CenterPixel = WorldToWidgetPixel(LoadWorldXY(InstanceID));
	const float2 DiameterPixels = RoundedDiameterPixels(UnitRadiusUU);
	const float2 PixelPosition = CenterPixel + (QuadCorners[VertexID] - 0.5) * DiameterPixels;
	Output.Position = bValid ? PixelToClip(PixelPosition) : float4(-2.0, -2.0, 0.0, 1.0);
	Output.Color = bValid ? TeamColors[TeamID] : 0.0.xxxx;
	return Output;
}

float4 UnitPS(FUnitVSToPS Input) : SV_Target0
{
	return Input.Color;
}

FVisionVSToPS VisionVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID)
{
	FVisionVSToPS Output;
	const uint TeamID = asuint(DynamicParams0[InstanceID].w) & 1023u;
	// Conservative default: only the viewing team shares vision. Allied-team
	// relationships require an explicit future input and are not guessed here.
	const bool bValid = IsHidden[InstanceID] == 0u && TeamID == ViewingTeamIndex;
	const float2 CenterPixel = WorldToWidgetPixel(LoadWorldXY(InstanceID));
	const float2 DiameterPixels = RoundedDiameterPixels(VisionRadiusUU);
	const float2 PixelPosition = CenterPixel + (QuadCorners[VertexID] - 0.5) * DiameterPixels;
	Output.Position = bValid ? PixelToClip(PixelPosition) : float4(-2.0, -2.0, 0.0, 1.0);
	Output.CircleUV = QuadCorners[VertexID] * 2.0 - 1.0;
	return Output;
}

float4 VisionPS(FVisionVSToPS Input) : SV_Target0
{
	clip(1.0 - dot(Input.CircleUV, Input.CircleUV));
	return 0.0.xxxx;
}

float4 FogVS(uint VertexID : SV_VertexID) : SV_Position
{
	return PixelToClip(RectMin + QuadCorners[VertexID] * RectSize);
}

float4 FogPS() : SV_Target0
{
	return float4(0.0, 0.0, 0.0, FogOpacity);
}
